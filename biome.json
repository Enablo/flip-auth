{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!pnpm-lock.yaml", "!**/*.md"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedImports": "error" },
      "style": {
        "useNodejsImportProtocol": "error",
        "useBlockStatements": "error",
        "useConst": "error",
        "useTemplate": "error",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["info", "warn", "error"] } },
        "noExplicitAny": "warn"
      }
    }
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
