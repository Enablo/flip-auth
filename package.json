{
  "name": "@enablo/flip-auth",
  "version": "0.1.1",
  "description": "Sign in with Flip (Keycloak OIDC, authorisation code + PKCE) for Node and edge apps, with optional Hono routes. Unofficial; not made by Flip.",
  "keywords": [
    "flip",
    "getflip",
    "oidc",
    "openid-connect",
    "keycloak",
    "pkce",
    "authentication",
    "hono"
  ],
  "author": "Enablo",
  "license": "MIT",
  "homepage": "https://github.com/Enablo/flip-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enablo/flip-auth.git"
  },
  "bugs": "https://github.com/Enablo/flip-auth/issues",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome format . --write",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "openid-client": "^6.8.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^20.19.43",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
